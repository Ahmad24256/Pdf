{
  "expo": {
    "name": "Offline Docs",
    "slug": "offline-docs",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-sqlite",
      "expo-file-system",
      "expo-document-picker",
      ["react-native-pdf-jsi", { "ocr": false }],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}
